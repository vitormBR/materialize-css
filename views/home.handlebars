<div class="section">

<div class="row">

    <div class="col s12 center-align">

        <h2 class="blue-text text-darken-3">
            Bem-vindo ao CineWeb
        </h2>

        <p class="flow-text grey-text">
            Sistema para gerenciamento de filmes,
