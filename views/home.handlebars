                    movie
                </i>

                <span class="card-title">
                    Filmes
                </span>

                <p>
                    Consulte os filmes cadastrados no sistema.
                </p>

            </div>

            <div class="card-action center-align">

                <a href="/filmes">
                    Ver Filmes
                </a>

            </div>

        </div>

    </div>


    <div class="col s12 m6 l3">

        <div class="card">

            <div class="card-content center-align">

                <i class="material-icons large blue-text text-darken-3">
                    person
                </i>

                <span class="card-title">
                    Artistas
                </span>

                <p>
                    Consulte os artistas cadastrados.
                </p>

            </div>

            <div class="card-action center-align">

                <a href="/artistas">
