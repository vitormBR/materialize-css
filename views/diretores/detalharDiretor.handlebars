<div class="container">
    <h3>Detalhes do Diretor</h3>

    <div class="card">
        <div class="card-content">

            <span class="card-title">
                {{diretor.nome}}
            </span>

            <p>
                <b>ID:</b> {{diretor.id}}
            </p>

            <p>
                <b>Nome:</b> {{diretor.nome}}
            </p>

            <p>
                <b>Foto:</b> {{diretor.foto}}
            </p>

            <p>
                <b>Data de Nascimento:</b>
                {{diretor.dataNascimento}}
            </p>

            <p>
                <b>Biografia:</b>
                {{diretor.biografia}}
            </p>

            <p>
                <b>Nacionalidade:</b>
                {{diretor.nacionalidade}}
            </p>

            <h5>Filmes dirigidos</h5>

            <ul class="collection">
                {{#each diretor.filmes}}
                <li class="collection-item">
                    {{titulo}}
                </li>
                {{else}}
                <li class="collection-item">
                    Nenhum filme cadastrado.
                </li>
                {{/each}}
            </ul>

        </div>
    </div>

    <a href="/diretores" class="btn blue">
        Voltar
    </a>
</div>