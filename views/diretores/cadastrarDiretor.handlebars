
<div class="container">
    <h3>Cadastrar Diretor</h3>

    <div class="card">
        <div class="card-content">

            <form action="/diretores"
                  method="POST">

                <div class="input-field">
                    <input
                        type="text"
                        name="nome"
                        id="nome"
                        required>

                    <label for="nome">
                        Nome
                    </label>
                </div>

                <div class="input-field">
                    <input
                        type="text"
                        name="nacionalidade"
                        id="nacionalidade"
                        required>

                    <label for="nacionalidade">
                        Nacionalidade
                    </label>
                </div>

                <button
                    type="submit"
                    class="btn green">
                    Cadastrar
                </button>

                <a href="/diretores"
                   class="btn grey">
                    Voltar
                </a>

            </form>
        </div>
    </div>
</div>