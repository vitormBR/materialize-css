<div class="container">
    <h3>Lista de Diretores</h3>

    <a href="/diretores/cadastrar"
       class="btn blue">
        Cadastrar Diretor
    </a>

    <table class="striped highlight">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Nacionalidade</th>
                <th>Data de Nascimento</th>
                <th>Detalhes</th>
            </tr>
        </thead>

        <tbody>
            {{#each diretores}}
            <tr>
                <td>{{id}}</td>
                <td>{{nome}}</td>
                <td>{{nacionalidade}}</td>
                <td>{{dataNascimento}}</td>
                <td>
                    <a href="/diretores/{{id}}"
                       class="btn-small blue">
                        Visualizar
                    </a>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="5">
                    Nenhum diretor cadastrado.
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>