<div class="container">
    <h3>Lista de Artistas</h3>

    <a href="/artistas/cadastrar"
       class="btn blue">
        Cadastrar Artista
    </a>

    <table class="striped highlight">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Nacionalidade</th>
                <th>Data de Nascimento</th>
                <th>Tipo</th>
                <th>Papéis</th>
                <th>Detalhes</th>
            </tr>
        </thead>

        <tbody>
            {{#each artistas}}
            <tr>
                <td>{{id}}</td>
                <td>{{nome}}</td>
                <td>{{nacionalidade}}</td>
                <td>{{dataNascimento}}</td>
                <td>{{tipo}}</td>
                <td>{{papeis}}</td>
                <td>
                    <a href="/artistas/{{id}}"
                       class="btn-small blue">
                        Visualizar
                    </a>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="7">
                    Nenhum artista cadastrado.
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>