<div class="container">
    <div class="page-header">
        <h3>Artistas</h3>
        <p>Artistas cadastrados no sistema.</p>
    </div>

    <div class="action-buttons">
        <a href="/artistas/cadastrar" class="btn blue darken-2">
            <i class="material-icons left">add</i>
            Cadastrar Artista
        </a>
    </div>

    <div class="card table-card">
        <table class="striped highlight responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Nacionalidade</th>
                    <th>Data de Nascimento</th>
                    <th>Tipo</th>
                    <th>Papéis</th>
                    <th>Detalhes</th>
                </tr>
            </thead>

            <tbody>
                {{#each artistas}}
                <tr>
                    <td>{{id}}</td>
                    <td><b>{{nome}}</b></td>
                    <td>{{nacionalidade}}</td>
                    <td>{{dataNascimento}}</td>
                    <td>{{tipo}}</td>
                    <td>{{papeis}}</td>
                    <td>
                        <a href="/artistas/{{id}}" class="btn-small blue">
                            <i class="material-icons">visibility</i>
                        </a>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="7" class="empty-state">
                        Nenhum artista cadastrado.
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
