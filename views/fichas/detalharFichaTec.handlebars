
<div class="container">
    <h3>Detalhes da Ficha Técnica</h3>

    <div class="card">
        <div class="card-content">

            <span class="card-title">
                {{ficha.filme.titulo}}
            </span>

            <p>
                <b>ID:</b> {{ficha.id}}
            </p>

            <p>
                <b>Filme:</b>
                {{ficha.filme.titulo}}
            </p>

            <p>
                <b>Duração:</b>
                {{ficha.duracao}} minutos
            </p>

            <p>
                <b>Ano:</b>
                {{ficha.filme.ano}}
            </p>

        </div>
    </div>

    <a href="/fichas" class="btn blue">
        Voltar
    </a>
</div>