<div class="container">
    <h3>Detalhes da Ficha Técnica</h3>

    <div class="card">
        <div class="card-content">

            <span class="card-title">
                Ficha Técnica
            </span>

            <p>
                <b>ID:</b>
                {{ficha.id}}
            </p>

            <p>
                <b>Filme:</b>
                {{ficha.filme.titulo}}
            </p>

            <p>
                <b>Roteirista:</b>
                {{ficha.roteirista}}
            </p>

            <p>
                <b>Produtor:</b>
                {{ficha.produtor}}
            </p>

            <p>
                <b>Compositor:</b>
                {{ficha.compositor}}
            </p>

            <p>
                <b>Editor:</b>
                {{ficha.editor}}
            </p>

            <p>
                <b>Duração:</b>
                {{ficha.duracao}} minutos
            </p>

            <p>
                <b>Orçamento:</b>
                {{ficha.orcamento}}
            </p>

        </div>
    </div>

    <a href="/ficha-tecnica" class="btn blue">
        Voltar
    </a>
</div>