<div class="container">
    <div class="page-header">
        <h3>Fichas Técnicas</h3>
        <p>Informações técnicas dos filmes cadastrados.</p>
    </div>

    <div class="action-buttons">
        <a href="/ficha-tecnica/cadastrar" class="btn blue darken-2">
            <i class="material-icons left">add</i>
            Cadastrar Ficha
        </a>
    </div>

    <div class="card table-card">
        <table class="striped highlight responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Filme</th>
                    <th>Roteirista</th>
                    <th>Produtor</th>
                    <th>Compositor</th>
                    <th>Editor</th>
                    <th>Duração</th>
                    <th>Orçamento</th>
                    <th>Detalhes</th>
                </tr>
            </thead>

            <tbody>
                {{#each fichasTecnicas}}
                <tr>
                    <td>{{id}}</td>
                    <td><b>{{#if filme}}{{filme.titulo}}{{else}}-{{/if}}</b></td>
                    <td>{{roteirista}}</td>
                    <td>{{produtor}}</td>
                    <td>{{compositor}}</td>
                    <td>{{editor}}</td>
                    <td>{{duracao}} min</td>
                    <td>{{orcamento}}</td>
                    <td>
                        <a href="/ficha-tecnica/{{id}}" class="btn-small blue">
                            <i class="material-icons">visibility</i>
                        </a>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="9" class="empty-state">
                        Nenhuma ficha técnica cadastrada.
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
