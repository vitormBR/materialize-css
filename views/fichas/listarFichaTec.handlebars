<div class="container">
    <h3>Lista de Fichas Técnicas</h3>

    <a href="/ficha-tecnica/cadastrar"
       class="btn blue">
        Cadastrar Ficha Técnica
    </a>

    <table class="striped highlight">
        <thead>
            <tr>
                <th>ID</th>
                <th>Filme</th>
                <th>Roteirista</th>
                <th>Produtor</th>
                <th>Compositor</th>
                <th>Editor</th>
                <th>Duração</th>
                <th>Orçamento</th>
                <th>Detalhes</th>
            </tr>
        </thead>

        <tbody>
            {{#each fichasTecnicas}}
            <tr>
                <td>{{id}}</td>
                <td>{{filme.titulo}}</td>
                <td>{{roteirista}}</td>
                <td>{{produtor}}</td>
                <td>{{compositor}}</td>
                <td>{{editor}}</td>
                <td>{{duracao}} minutos</td>
                <td>{{orcamento}}</td>
                <td>
                    <a href="/ficha-tecnica/{{id}}"
                       class="btn-small blue">
                        Visualizar
                    </a>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="9">
                    Nenhuma ficha cadastrada.
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>