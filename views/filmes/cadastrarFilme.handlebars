<div class="container">
    <h3>Cadastrar Filme</h3>

    <div class="card">
        <div class="card-content">

            <form action="/filmes" method="POST">

                <div class="input-field">
                    <input
                        type="text"
                        name="titulo"
                        id="titulo"
                        required>

                    <label for="titulo">
                        Título
                    </label>
                </div>

                <div class="input-field">
                    <input
                        type="number"
                        name="ano"
                        id="ano">

                    <label for="ano">
                        Ano
                    </label>
                </div>

                <div class="input-field">
                    <textarea
                        name="sinopse"
                        id="sinopse"
                        class="materialize-textarea"></textarea>

                    <label for="sinopse">
                        Sinopse
                    </label>
                </div>

                <div class="input-field">
                    <input
                        type="number"
                        name="duracao"
                        id="duracao"
                        min="1">

                    <label for="duracao">
                        Duração (minutos)
                    </label>
                </div>

                <div class="input-field">
                    <input
                        type="text"
                        name="genero"
                        id="genero">

                    <label for="genero">
                        Gênero
                    </label>
                </div>

                <div class="input-field">
                    <input
                        type="number"
                        name="clasIndicativa"
                        id="clasIndicativa">

                    <label for="clasIndicativa">
                        Classificação indicativa
                    </label>
                </div>

                <div class="input-field">
                    <input
                        type="text"
                        name="paisOrigem"
                        id="paisOrigem">

                    <label for="paisOrigem">
                        País de origem
                    </label>
                </div>

                <div class="input-field">
                    <select name="diretorId" id="diretorId">

                        <option
                            value=""
                            disabled
                            selected>
                            Selecione um diretor
                        </option>

                        {{#each diretores}}
                        <option value="{{id}}">
                            {{nome}}
                        </option>
                        {{/each}}

                    </select>

                    <label>Diretor</label>
                </div>

                <button
                    type="submit"
                    class="btn green">
                    Cadastrar
                </button>

                <a
                    href="/filmes"
                    class="btn grey">
                    Voltar
                </a>

            </form>

        </div>
    </div>
</div>